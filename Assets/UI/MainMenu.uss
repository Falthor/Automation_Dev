.hidden {
    display: none;
}

.main-menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.main-menu-background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.main-menu-panel {
    align-items: center;
    background-color: rgba(16, 20, 25, 0.85);
    border-width: 2px;
    border-color: rgb(48, 59, 66);
    padding: 32px 40px;
}

.main-menu-title {
    color: rgb(85, 221, 245);
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 24px;
}

.main-menu-button {
    width: 260px;
    height: 44px;
    margin-bottom: 12px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(220, 220, 220);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.main-menu-button:hover {
    border-color: rgb(85, 221, 245);
    color: rgb(85, 221, 245);
}

.main-menu-button:disabled {
    opacity: 0.4;
}

.confirm-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.confirm-dialog {
    width: 380px;
    align-items: center;
    background-color: rgb(16, 20, 25);
    border-width: 2px;
    border-color: rgb(232, 168, 61);
    padding: 24px;
}

.confirm-message {
    color: rgb(220, 220, 220);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.confirm-button-row {
    flex-direction: row;
}

.confirm-button {
    width: 165px;
    margin: 0 4px;
}

.confirm-button-danger {
    border-color: rgb(222, 107, 74);
    color: rgb(222, 107, 74);
}

.confirm-button-danger:hover {
    border-color: rgb(242, 83, 83);
    color: rgb(242, 83, 83);
}

/* --- The shortcuts screen ---
   Right angles, small caps for section headings only, and the key itself in the tabular monospace
   the game panels use for every value. A key is a value: a column of them that shifts its own left
   edge whenever one row says "Espace" and the next says "R" is a column the eye has to re-find. */

.shortcuts-dialog {
    width: 520px;
    max-height: 78%;
    background-color: rgb(16, 20, 25);
    border-width: 2px;
    border-color: rgb(48, 59, 66);
    padding: 24px;
}

.shortcuts-title {
    color: rgb(85, 221, 245);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 8px;
}

.shortcuts-hint {
    color: rgb(138, 152, 160);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 14px;
}

.shortcuts-list {
    flex-grow: 1;
    margin-bottom: 16px;
}

/* Spaced capitals, 10px, muted: the one place small caps are used, exactly as the game panels do
   it. A section heading names a group, it is not a row. */
.shortcuts-section {
    color: rgb(139, 147, 161);
    font-size: 10px;
    letter-spacing: 1px;
    margin: 10px 0 4px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(38, 45, 54);
}

.shortcuts-section-first {
    margin-top: 0;
}

.shortcuts-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 0;
}

.shortcuts-row-label {
    flex-grow: 1;
    color: rgb(220, 220, 220);
    font-size: 12px;
}

/* The key. Fixed width so the column is a column, and the monospace face so its glyphs sit on a
   grid - see the block comment above. */
.shortcuts-key {
    width: 132px;
    height: 26px;
    margin: 0 6px 0 0;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    border-radius: 0;
    color: rgb(220, 220, 220);
    font-size: 12px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("Fonts/RobotoMono-Regular.ttf");
}

.shortcuts-key:hover {
    border-color: rgb(85, 221, 245);
    color: rgb(85, 221, 245);
}

/* Waiting for a key. Amber, the colour this project already uses for "under way", so the one row
   that is listening does not look like the seventeen that are not. */
.shortcuts-key-listening {
    border-color: rgb(232, 168, 61);
    color: rgb(232, 168, 61);
}

/* An action the player left with no key at all, after overwriting its shortcut elsewhere. It has
   to read as a hole rather than as a row that happens to be quiet. */
.shortcuts-key-unassigned {
    color: rgb(138, 152, 160);
    border-color: rgb(38, 45, 54);
    -unity-font-style: italic;
}

.shortcuts-reset {
    width: 26px;
    height: 26px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(38, 45, 54);
    border-radius: 0;
    color: rgb(138, 152, 160);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.shortcuts-reset:hover {
    border-color: rgb(85, 221, 245);
    color: rgb(85, 221, 245);
}

/* Nothing to put back: this row is already on its default. Disabled rather than hidden, so the
   column of buttons stays a straight line. */
.shortcuts-reset:disabled {
    opacity: 0.25;
}

.shortcuts-footer {
    flex-direction: row;
    justify-content: flex-end;
}

.shortcuts-footer-button {
    width: 170px;
    height: 34px;
    margin: 0 0 0 8px;
    font-size: 12px;
}
