<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameUI.uss" />

    <ui:VisualElement name="DataCenterPanelRoot" class="overlay-root overlay-root-right hidden" picking-mode="Ignore">
        <ui:VisualElement class="panel panel-accent datacenter-panel" picking-mode="Position">
            <ui:VisualElement class="header-row">
                <ui:Label text="DATA CENTER" class="title" />
                <ui:Button name="DataCenterCloseButton" text="&#215;" class="close-button" />
            </ui:VisualElement>
            <ui:VisualElement class="inline-icon-row">
                <ui:VisualElement name="DataCenterComputeIcon" class="inline-icon" />
                <ui:Label name="DataCenterComputeLabel" text="Compute produit: 0 CU/s" class="extractor-section-label" />
            </ui:VisualElement>
            <ui:VisualElement class="inline-icon-row">
                <ui:VisualElement name="DataCenterPowerIcon" class="inline-icon" />
                <ui:Label name="DataCenterPowerLabel" text="Power consommee: 0 kW" class="extractor-section-label" />
            </ui:VisualElement>
            <ui:Label text="CPU" class="extractor-section-label" />
            <ui:VisualElement name="DataCenterCpuList" class="datacenter-slot-list" />
            <ui:Label text="MEMOIRE" class="extractor-section-label" />
            <ui:VisualElement name="DataCenterMemoryList" class="datacenter-slot-list" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
