<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameUI.uss" />

    <ui:VisualElement name="LaboratoryPanelRoot" class="overlay-root overlay-root-right hidden" picking-mode="Ignore">
        <ui:VisualElement class="panel panel-accent" picking-mode="Position">
            <ui:VisualElement class="header-row">
                <ui:Label text="LABORATORY" class="title" />
                <ui:Button name="LaboratoryCloseButton" text="&#215;" class="close-button" />
            </ui:VisualElement>
            <ui:VisualElement class="extractor-body">
                <ui:Label text="CARTES DE DONNEES" class="extractor-section-label" />
                <ui:VisualElement class="storage-card">
                    <ui:VisualElement name="LaboratoryCardIcon" class="storage-card-icon" />
                    <ui:Label name="LaboratoryCardAmount" text="0" class="storage-card-count" />
                </ui:VisualElement>
                <ui:Label text="CYCLE" class="extractor-section-label" />
                <ui:VisualElement class="extractor-progress-track">
                    <ui:VisualElement name="LaboratoryProgressFill" class="extractor-progress-fill" />
                </ui:VisualElement>
                <ui:Label name="LaboratoryProgressLabel" text="0.0 / 0.0 s" class="production-time-label" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
