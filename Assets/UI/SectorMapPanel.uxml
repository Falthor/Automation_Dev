<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameUI.uss" />

    <ui:VisualElement name="SectorMapPanelRoot" class="overlay-root hidden" picking-mode="Ignore">
        <ui:VisualElement class="panel panel-accent sector-map-panel" picking-mode="Position">
            <ui:VisualElement class="header-row">
                <ui:Label text="CARTE" class="title" />
                <ui:Button name="SectorMapCloseButton" text="&#215;" class="close-button" />
            </ui:VisualElement>

            <!-- The map, and nothing beside it. There is no target to designate and nothing to
                 describe: what this screen answers is what has been opened and where the robots
                 are, and both of those are drawn rather than written. -->
            <ui:VisualElement name="SectorMapViewport" class="sector-map-viewport" />

            <ui:VisualElement class="sector-map-footer">
                <ui:Label name="SectorMapFleet" text="" class="sector-map-hover-name" />
                <ui:Label name="SectorMapHint" text="molette pour zoomer · glisser pour déplacer"
                          class="sector-map-hint" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
