<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameUI.uss" />

    <ui:VisualElement name="SectorMapPanelRoot" class="overlay-root hidden" picking-mode="Ignore">
        <ui:VisualElement class="panel panel-accent sector-map-panel" picking-mode="Position">
            <ui:VisualElement class="header-row">
                <ui:Label text="CARTE" class="title" />
                <ui:Button name="SectorMapCloseButton" text="&#215;" class="close-button" />
            </ui:VisualElement>

            <!-- Says where one is and offers the way out, in one line. A back button alone would say
                 less, and would need explaining. -->
            <ui:VisualElement name="SectorMapCrumbs" class="sector-map-crumbs" />

            <ui:VisualElement class="sector-map-body">
                <ui:VisualElement name="SectorMapViewport" class="sector-map-viewport" />

                <!-- What the aimed sector is, and what may be sent to it. Beside the map rather than
                     under it: choosing a target and choosing what to do with it are one gesture, and
                     the answer must not move the map. -->
                <ui:VisualElement class="sector-map-aside">
                    <ui:Label text="CARTOGRAPHIE" class="extractor-section-label" />
                    <ui:Label name="SectorMapZoneName" text="" class="sector-map-zone-name" />
                    <ui:VisualElement class="sector-map-progress-track">
                        <ui:VisualElement name="SectorMapProgressFill" class="sector-map-progress-fill" />
                    </ui:VisualElement>
                    <ui:Label name="SectorMapProgress" text="" class="sector-map-figure mono-value" />

                    <ui:Label name="SectorMapCountsTitle" text="SITES CONNUS" class="extractor-section-label section-label-spaced" />
                    <ui:VisualElement name="SectorMapSiteCounts" class="sector-map-counts" />

                    <ui:Label text="MISSIONS" class="extractor-section-label section-label-spaced" />
                    <ui:Label name="SectorMapTargetName" text="" class="sector-map-target-name" />
                    <ui:Label name="SectorMapTargetState" text="" class="sector-map-target-detail" />
                    <ui:VisualElement name="SectorMapMissionList" class="sector-map-mission-list" />

                    <ui:Label name="SectorMapFleet" text="" class="sector-map-fleet" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="sector-map-footer">
                <ui:Label name="SectorMapHoverName" text="" class="sector-map-hover-name" />
                <ui:Label name="SectorMapHoverDetail" text="" class="sector-map-hover-detail" />
                <ui:Label name="SectorMapHint" text="molette pour zoomer · glisser pour déplacer · cliquer une zone pour la cadrer"
                          class="sector-map-hint" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
