<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Shortcuts" src="Shortcuts.uxml" />
    <ui:Template name="GameMenu" src="GameMenu.uxml" />
    <Style src="GameUI.uss" />

    <ui:VisualElement name="TopBarRoot" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; height: 36px;">
        <ui:VisualElement name="TopBarHeaderBg" class="top-bar-header-bg" picking-mode="Ignore">
            <ui:Label name="TopBarClock" text="00:00" picking-mode="Ignore" class="top-bar-clock" />
            <ui:VisualElement name="TopBarLeftRow" class="top-bar-elements-left" picking-mode="Ignore" style="flex-direction: row;" />
            <ui:VisualElement name="TopBarRightRow" class="top-bar-elements-right" picking-mode="Ignore" style="flex-direction: row;" />
            <ui:Button name="TopBarMenuButton" text="&#9776;" class="top-bar-icon-button" />
            <ui:Button name="TopBarPauseButton" text="II" class="top-bar-icon-button" />
        </ui:VisualElement>
        <ui:Label name="TopBarPauseOverlay" text="PAUSE" picking-mode="Ignore" class="top-bar-pause-overlay hidden" />
        <ui:Label name="TopBarRefusalMessage" text="" picking-mode="Ignore" class="top-bar-refusal-message hidden" />
    </ui:VisualElement>
    <ui:Instance template="Shortcuts" name="ShortcutsHost" />
    <ui:Instance template="GameMenu" name="GameMenuHost" />
</ui:UXML>
