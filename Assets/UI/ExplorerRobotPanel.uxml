<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameUI.uss" />

    <ui:VisualElement name="ExplorerRobotPanelRoot" class="overlay-root overlay-root-right hidden" picking-mode="Ignore">
        <ui:VisualElement class="panel panel-accent" picking-mode="Position">
            <ui:VisualElement class="header-row">
                <ui:Label name="ExplorerRobotTitle" text="Robot explorateur" class="title title-name" />
                <ui:Button name="ExplorerRobotCloseButton" text="&#215;" class="close-button" />
            </ui:VisualElement>

            <ui:VisualElement class="extractor-body">
                <ui:Label text="ÉTAT" class="extractor-section-label section-label-spaced" />
                <ui:VisualElement class="production-rate-row">
                    <ui:Label text="ACTIVITÉ" class="production-rate-caption" />
                    <ui:Label name="ExplorerRobotState" text="" class="production-rate-value" />
                </ui:VisualElement>
                <ui:VisualElement class="production-rate-row">
                    <ui:Label text="DISTANCE" class="production-rate-caption" />
                    <ui:Label name="ExplorerRobotDistance" text="" class="production-rate-value" />
                </ui:VisualElement>
                <!-- The one line that decides whether the player recalls the robot: a full one, or
                     one going back over ground it already opened, looks exactly like one at work. -->
                <ui:VisualElement class="production-rate-row">
                    <ui:Label text="RÉCOLTE" class="production-rate-caption" />
                    <ui:Label name="ExplorerRobotHarvest" text="" class="production-rate-value" />
                </ui:VisualElement>

                <ui:Label text="DATACARDS" class="extractor-section-label section-label-spaced" />
                <ui:VisualElement class="storage-card">
                    <ui:VisualElement name="ExplorerRobotCardIcon" class="storage-card-icon" />
                    <ui:Label name="ExplorerRobotCards" text="0/10" class="storage-card-count" />
                </ui:VisualElement>

                <!-- Auto lights up while the robot wanders on its own; Retour always sends it
                     straight home. A right-click on the map (ConstructionInputAdapter) is the third
                     control - it is not a button, so it has no element here. -->
                <ui:VisualElement class="explorer-robot-action-row">
                    <ui:Button name="ExplorerRobotAutoButton" text="Auto" class="recipe-action-button" />
                    <ui:Button name="ExplorerRobotReturnButton" text="Retour" class="recipe-action-button" />
                </ui:VisualElement>
                <ui:Label name="ExplorerRobotHint" text="" class="production-time-label" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
