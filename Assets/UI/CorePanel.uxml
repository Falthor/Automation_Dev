<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameUI.uss" />

    <ui:VisualElement name="CorePanelRoot" class="overlay-root overlay-root-right hidden" picking-mode="Ignore">
        <ui:VisualElement class="panel panel-accent datacenter-panel" picking-mode="Position">
            <ui:VisualElement class="header-row">
                <ui:Label text="CORE" class="title" />
                <ui:Button name="CoreCloseButton" text="&#215;" class="close-button" />
            </ui:VisualElement>
            <ui:VisualElement class="inline-icon-row">
                <ui:VisualElement name="CoreComputeIcon" class="inline-icon" />
                <ui:Label name="CoreComputeLabel" text="Compute: 0 CU/s" class="extractor-section-label" />
            </ui:VisualElement>
            <ui:VisualElement class="inline-icon-row">
                <ui:VisualElement name="CorePowerIcon" class="inline-icon" />
                <ui:Label name="CorePowerLabel" text="Power: 0 kW" class="extractor-section-label" />
            </ui:VisualElement>
            <ui:Label text="INVENTAIRE" class="extractor-section-label" />
            <ui:VisualElement name="CoreItemsList" class="production-ingredients-list" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
