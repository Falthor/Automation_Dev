<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameUI.uss" />

    <ui:VisualElement name="CorePanelRoot" class="overlay-root overlay-root-right hidden" picking-mode="Ignore">
        <ui:VisualElement class="panel panel-accent datacenter-panel" picking-mode="Position">
            <ui:VisualElement class="header-row">
                <ui:Label text="Noyau" class="title title-name" />
                <ui:Button name="CoreCloseButton" text="&#215;" class="close-button" />
            </ui:VisualElement>
            <ui:VisualElement class="inline-icon-row">
                <ui:VisualElement name="CoreComputeIcon" class="inline-icon" />
                <ui:Label name="CoreComputeLabel" text="Compute: 0 CU/s" class="extractor-section-label" />
            </ui:VisualElement>
            <ui:VisualElement class="inline-icon-row">
                <ui:VisualElement name="CorePowerIcon" class="inline-icon" />
                <ui:Label name="CorePowerLabel" text="Power: 0 kW" class="extractor-section-label" />
            </ui:VisualElement>
            <!-- The directive the Core is currently asking for. Hidden entirely once there are
                 none left, which is the whole of "plus rien ne s'affiche". -->
            <ui:VisualElement name="CoreDirective" class="core-directive hidden">
                <ui:Label name="CoreDirectiveTitle" text="DIRECTIVE" class="extractor-section-label section-label-spaced" />
                <ui:VisualElement name="CoreDirectiveRequirements" class="core-directive-requirements" />

                <ui:Label name="CoreDirectiveRewardTitle" text="RÉCOMPENSE" class="extractor-section-label section-label-spaced" />
                <ui:VisualElement name="CoreDirectiveRewardItem" class="core-directive-reward">
                    <ui:VisualElement name="CoreDirectiveRewardIcon" class="core-directive-reward-icon" />
                    <ui:Label name="CoreDirectiveRewardName" text="" class="core-directive-reward-name" />
                </ui:VisualElement>
                <!-- Rewards that are not items. Each gets its own row rather than text appended to
                     the item's name, so a directive granting only one of them shows exactly that
                     one. -->
                <!-- Worded by the directive itself (CoreDirectiveDefinition.RewardLabels), not by
                     the unlock it grants, and one row per entry: an unlock can open four things and
                     naming them in a single label ran off the edge of the panel. Rows are built by
                     the controller. -->
                <ui:VisualElement name="CoreDirectiveRewardResearchList" class="hidden" />

                <ui:Button name="CoreDirectiveValidate" text="VALIDER" class="recipe-action-button" />
            </ui:VisualElement>

            <ui:VisualElement name="CoreItemsList" class="production-ingredients-list" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
