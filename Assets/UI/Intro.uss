.intro-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    overflow: hidden;
}

.crawl-text {
    position: absolute;
    left: 0;
    right: 0;
    align-items: center;
}

.crawl-title {
    color: rgb(85, 221, 245);
    font-size: 36px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    margin-bottom: 64px;
}

.crawl-stanza {
    align-items: center;
    margin-bottom: 32px;
}

.crawl-stanza-last {
    margin-bottom: 0;
}

.crawl-line {
    color: rgb(220, 220, 220);
    font-size: 18px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.crawl-emphasis {
    color: rgb(85, 221, 245);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}
