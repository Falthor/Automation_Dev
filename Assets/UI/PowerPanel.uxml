<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameUI.uss" />

    <ui:VisualElement name="PowerPanelRoot" class="overlay-root hidden" picking-mode="Ignore">
        <ui:VisualElement class="panel panel-accent" picking-mode="Position">
            <ui:VisualElement class="header-row">
                <ui:Label text="POWER" class="title" />
                <ui:Button name="PowerCloseButton" text="&#215;" class="close-button" />
            </ui:VisualElement>
            <ui:VisualElement class="extractor-body">
                <ui:Label name="PowerConsumptionLabel" text="Consumption: 0 kW" class="extractor-section-label" />
                <ui:Label name="PowerProductionLabel" text="Production: 0 kW" class="extractor-section-label" />
                <ui:Label name="PowerBalanceLabel" text="Balance: +0 kW" class="extractor-section-label" />
                <ui:VisualElement class="extractor-progress-track">
                    <ui:VisualElement name="PowerBarFill" class="extractor-progress-fill" />
                </ui:VisualElement>
                <ui:VisualElement name="PowerGraphContainer" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
