<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameUI.uss" />

    <ui:VisualElement name="StoragePanelRoot" class="overlay-root hidden" picking-mode="Ignore">
        <ui:VisualElement class="panel panel-accent" picking-mode="Position">
            <ui:VisualElement class="header-row">
                <!-- Grouped like the production panel's title and pause, so the button sits against
                     the name instead of being pushed to the middle by the row's space-between. -->
                <ui:VisualElement class="header-title-group">
                    <ui:Label name="StorageTitle" text="Boite Rudimentaire" class="title title-name" />
                    <ui:Button name="StorageMoveButton" text="✥" class="header-toggle-button" />
                </ui:VisualElement>
                <ui:Button name="StorageCloseButton" text="&#215;" class="close-button" />
            </ui:VisualElement>
            <ui:VisualElement name="StorageGrid" class="storage-grid" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
