<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameUI.uss" />

    <ui:VisualElement name="StoragePanelRoot" class="overlay-root hidden" picking-mode="Ignore">
        <ui:VisualElement class="panel panel-accent" picking-mode="Position">
            <ui:VisualElement class="header-row">
                <ui:Label name="StorageTitle" text="STORAGE" class="title" />
                <ui:Button name="StorageCloseButton" text="&#215;" class="close-button" />
            </ui:VisualElement>
            <ui:VisualElement name="StorageGrid" class="storage-grid" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
