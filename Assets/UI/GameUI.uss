.hidden {
    display: none;
}

.overlay-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-start;
}

/* Per-building context panels (Extractor, Storage box, Production) dock to the right edge
   instead of the centered default used by the Building catalog/aggregate Storage view. */
.overlay-root-right {
    align-items: flex-end;
}

.overlay-root-right .panel {
    align-self: flex-end;
    margin-right: 24px;
}

.panel {
    margin-top: 90px;
    align-self: center;
    background-color: rgba(16, 20, 25, 0.98);
    border-width: 2px;
    border-color: rgb(48, 59, 66);
    padding: 10px;
}

.panel-accent {
    border-left-width: 1px;
    border-left-color: rgba(54, 199, 232, 0.4);
}

.header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(48, 59, 66);
    padding-bottom: 5px;
}

.title {
    color: rgb(85, 221, 245);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.close-button {
    width: 22px;
    height: 22px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(220, 220, 220);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.close-button:hover {
    border-color: rgb(85, 221, 245);
    color: rgb(85, 221, 245);
}

/* The Building menu is 20% larger than the shared panel default, frame included - it is the one
   panel the player reads a catalogue in, not a couple of figures. Scoped to this panel rather than
   applied to .panel, which every other overlay shares. */
.building-panel {
    padding: 12px;
    border-width: 2px;
}

.building-body {
    flex-direction: column;
}

.building-top-row {
    flex-direction: row;
}

.h-separator {
    height: 1px;
    background-color: rgb(48, 59, 66);
    margin: 10px 0;
}

.category-column {
    width: 180px;
    margin-right: 12px;
}

.v-separator {
    width: 1px;
    background-color: rgb(48, 59, 66);
    margin: 0 10px 0 0;
}

.category-button {
    height: 48px;
    margin-bottom: 7px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(200, 205, 210);
    font-size: 16px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 0 10px;
}

.category-button:hover {
    border-color: rgb(85, 221, 245);
}

.category-button-selected {
    border-color: rgb(85, 221, 245);
    color: rgb(85, 221, 245);
    background-color: rgb(26, 34, 40);
}

.category-button-icon {
    width: 24px;
    height: 24px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.category-button-label {
    color: rgb(200, 205, 210);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.category-button-selected .category-button-label {
    color: rgb(85, 221, 245);
}

.building-grid-scroll {
    width: 432px;
    max-height: 240px;
}

.building-grid-scroll .unity-scroller--vertical {
    width: 6px;
}

.building-grid-scroll .unity-scroller--vertical .unity-scroller__low-button,
.building-grid-scroll .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.building-grid-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    width: 4px;
    border-radius: 2px;
}

.building-grid-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    width: 4px;
    border-radius: 2px;
    background-color: rgb(85, 221, 245);
}

.building-grid {
    flex-direction: column;
}

.building-grid-row {
    flex-direction: row;
}

.building-card {
    width: 134px;
    height: 108px;
    margin: 5px;
    background-color: rgb(24, 29, 35);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    white-space: normal;
}

.building-card:hover {
    border-color: rgb(85, 221, 245);
    background-color: rgb(30, 37, 44);
}

.building-card-locked {
    opacity: 0.5;
}

.building-card-unaffordable {
    border-color: rgb(255, 216, 102);
}

.building-card-unaffordable .building-card-icon {
    -unity-background-image-tint-color: rgb(255, 216, 102);
}

.building-card-unaffordable .building-card-label {
    color: rgb(255, 216, 102);
}

.building-card-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 7px;
    -unity-background-scale-mode: scale-to-fit;
}

.building-card-label {
    color: rgb(220, 220, 220);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.storage-grid {
    flex-direction: column;
}

.storage-grid-row {
    flex-direction: row;
}

.storage-card {
    width: 52px;
    height: 52px;
    margin: 4px;
    background-color: rgb(10, 13, 15);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    border-radius: 3px;
    position: relative;
}

.storage-card-icon {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.storage-card-count {
    position: absolute;
    right: 2px;
    bottom: 1px;
    background-color: rgba(0, 0, 0, 0.65);
    color: rgb(85, 221, 245);
    font-size: 11px;
    -unity-font-style: bold;
    padding: 0 3px;
    border-radius: 3px;
}

.storage-card-empty {
    background-color: rgb(10, 13, 15);
    border-color: rgb(38, 46, 52);
}

.storage-empty-label {
    color: rgb(140, 148, 155);
    font-size: 12px;
    padding: 6px 4px;
}

/* Extractor panel */

.extractor-body {
    width: 220px;
}

.extractor-section-label {
    color: rgb(160, 168, 175);
    font-size: 10px;
    margin-bottom: 3px;
    margin-top: 5px;
}

.extractor-progress-track {
    width: 220px;
    height: 14px;
    background-color: rgb(10, 13, 15);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    border-radius: 3px;
    overflow: hidden;
}

.extractor-progress-fill {
    height: 100%;
    background-color: rgb(85, 221, 245);
}

/* Bottom Nav */

.bottom-nav {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 44px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(16, 20, 25, 0.92);
    border-top-width: 2px;
    border-top-color: rgba(54, 199, 232, 0.5);
    padding-left: 8px;
}

.bottom-nav-minimap {
    width: 44px;
    height: 38px;
    background-color: rgb(10, 13, 15);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    margin-right: 12px;
}

.bottom-nav-category-row {
    flex-direction: row;
    margin-right: 12px;
}

.bottom-nav-category-button {
    width: 40px;
    height: 40px;
    margin: 0 8px 0 0;
    padding: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.bottom-nav-category-button-active {
    background-color: rgb(22, 50, 58);
    border-color: rgb(85, 221, 245);
}

.bottom-nav-category-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.bottom-nav-toolbar-row {
    flex-direction: row;
}

.bottom-nav-slot {
    width: 36px;
    height: 36px;
    margin-right: 5px;
    border-radius: 3px;
}

.bottom-nav-slot-empty {
    background-color: rgb(10, 13, 15);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
}

.bottom-nav-slot-icon {
    position: absolute;
    left: 2px;
    top: 2px;
    right: 2px;
    bottom: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.bottom-nav-slot-number {
    position: absolute;
    left: 2px;
    top: 0;
    color: rgb(135, 147, 156);
    font-size: 8px;
}

.bottom-nav-slot-badge {
    position: absolute;
    right: 2px;
    bottom: 0;
    color: rgb(85, 221, 245);
    font-size: 9px;
    -unity-font-style: bold;
}

/* Production panel (Foundry/Factory/AdvancedFoundry/Assembler) */

/* Wide enough for a full row of 3 recipe cards (3 x 92px + their 3px margins + panel padding). */
.production-panel {
    width: 320px;
}

.production-tab-bar {
    flex-direction: row;
    margin-bottom: 6px;
}

.production-tab-button {
    flex-grow: 1;
    height: 24px;
    margin: 0;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(160, 168, 175);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.production-tab-button-active {
    border-color: rgb(85, 221, 245);
    color: rgb(85, 221, 245);
    background-color: rgb(26, 34, 40);
}

.recipes-grid {
    flex-direction: column;
}

.recipes-grid-row {
    flex-direction: row;
}

.recipe-card {
    width: 92px;
    margin: 3px;
    padding: 4px;
    background-color: rgb(24, 29, 35);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    align-items: center;
}

.recipe-card:hover {
    border-color: rgba(85, 221, 245, 0.55);
}

.recipe-card-selected {
    border-width: 2px;
    border-color: rgb(85, 221, 245);
    background-color: rgb(22, 50, 58);
}

.recipe-card-unavailable {
    opacity: 0.6;
}

.recipe-card-icon-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.recipe-card-icon {
    width: 18px;
    height: 18px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-card-amount {
    color: rgb(85, 221, 245);
    font-size: 9px;
}

.recipe-card-divider {
    width: 100%;
    height: 1px;
    background-color: rgb(48, 59, 66);
    margin-bottom: 3px;
}

/* Wraps rather than clipping: "COMPOSANT MECANIQUE" does not fit one line of a card this wide,
   and an ellipsis on an item name tells the player nothing. The card grows to fit instead. */
.recipe-card-name {
    color: rgb(215, 224, 229);
    font-size: 9px;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
    margin-bottom: 3px;
}

.recipe-card-ingredients-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-bottom: 3px;
}

/* One ingredient: its icon and its quantity, wrapped together by the row above. */
.recipe-card-ingredient {
    flex-direction: row;
    align-items: center;
}

.recipe-card-ingredient-icon {
    width: 12px;
    height: 12px;
    margin: 0 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-card-ingredient-qty {
    color: rgb(160, 168, 175);
    font-size: 7px;
    margin-right: 3px;
}

.recipe-card-time {
    color: rgb(135, 147, 156);
    font-size: 8px;
}

/* Under the craft duration on every recipe card: what that duration is worth per minute. Carries
   the throughput accent the whole UI uses for a rate, so the eye finds it as one figure across the
   Building menu, the recipe cards and the production panel. */
.recipe-card-rate {
    color: rgb(85, 221, 245);
    font-size: 10px;
    -unity-font-style: bold;
}

.recipe-action-button {
    height: 26px;
    margin: 4px 3px 0 3px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(200, 205, 210);
    font-size: 10px;
    -unity-font-style: bold;
}

.recipe-action-button:disabled {
    color: rgb(90, 96, 102);
}

.production-empty-state {
    color: rgb(140, 148, 155);
    font-size: 10px;
    padding: 5px 3px;
}

.production-content {
    width: 100%;
}

/* The item being made, in the same shape as every listed item: icon, name, value on the right.

   Set apart from the stock list above it, because it is not part of it. With ore in the building
   the section showed two identical-looking lines - "Minerai de fer 1" and "Lingot de fer 1" - of
   which only the first was stock; the second is what a cycle yields, and reading it as a held
   ingot is the wrong answer to "what is in this machine". The gap groups it with the bar below,
   whose progress is about it. */
.production-current-row {
    margin-top: 7px;
    margin-bottom: 6px;
}

.production-current-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.production-current-amount {
    color: rgb(220, 224, 228);
    font-size: 11px;
}

.production-current-name {
    color: rgb(220, 224, 228);
    font-size: 11px;
    flex-grow: 1;
}

.production-progress-track {
    width: 100%;
}

.production-percent-label {
    color: rgb(160, 168, 175);
    font-size: 9px;
    -unity-text-align: upper-right;
}

/* Remaining time on the left, percentage on the right, directly under a progress bar
   (Production and Extractor panels share it). */
.progress-info-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 5px;
}

/* Rated output per minute, directly under the progress bar and its countdown - the same row shape
   in the production panel and the extractor's, because it is the same statement in both. */
.production-rate-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: -3px;
    margin-bottom: 6px;
}

/* In the production panel the rate is the one value in large type, so the row packs the figure and
   its unit together on the left instead of pushing them to opposite edges. */
.production-panel .production-rate-row {
    justify-content: flex-start;
    align-items: flex-end;
    margin-top: 0;
    margin-bottom: 0;
}

/* The DÉBIT block sets its own spacing rather than inheriting the 13px section rhythm twice over.
   Left alone it collected the gap under the bar, the gap above a section label, and the gap below
   the row - some 45px of air around two lines of text, which read as three separate things
   floating rather than as one figure with a name. */
.production-rate-unit {
    color: rgb(135, 147, 156);
    font-size: 12px;
    margin-left: 4px;
    margin-bottom: 2px;
}

.production-rate-caption {
    color: rgb(135, 147, 156);
    font-size: 9px;
    letter-spacing: 0.5px;
}

.production-rate-value {
    color: rgb(85, 221, 245);
    font-size: 12px;
    -unity-font-style: bold;
}

/* 19px, and only here. DÉBIT is the line that answers "is this running well"; every other line
   answers a narrower question and keeps the compact form. Make them all large and the panel is a
   list again, with nothing to look at first. */
.production-panel .production-rate-value {
    font-size: 19px;
    -unity-font-style: normal;
}

/* Core directive: what the Core is asking for, big enough to be the point of the panel rather than
   another list inside it. */
.core-directive {
    margin-bottom: 6px;
}

.core-directive-requirements {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 6px;
}

.core-directive-requirement {
    align-items: center;
    margin: 4px 10px;
}

.core-directive-requirement-icon {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 3px;
}

.core-directive-requirement-amount {
    color: rgb(200, 205, 210);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Green once that requirement is covered - the same "nothing to do here" green the production
   panel's ingredient rows use. */
.core-directive-requirement-met {
    color: rgb(100, 210, 130);
}

.core-directive-reward {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.core-directive-reward-icon {
    width: 24px;
    height: 24px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.core-directive-reward-name {
    color: rgb(85, 221, 245);
    font-size: 12px;
    -unity-font-style: bold;
}

/* Stands in the icon's place for a reward that has no item to show (the Research menu), so both
   reward lines start at the same left edge. */
.core-directive-reward-glyph {
    width: 24px;
    height: 24px;
    margin-right: 6px;
    border-width: 1px;
    border-color: rgb(85, 221, 245);
    background-color: rgb(22, 50, 58);
}

.production-ingredients-list {
    flex-direction: column;
}

.production-ingredient-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.production-ingredient-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.production-ingredient-name {
    color: rgb(200, 205, 210);
    font-size: 10px;
    flex-grow: 1;
}

.production-ingredient-status-ok {
    color: rgb(100, 210, 130);
    font-size: 10px;
}

.production-ingredient-status-missing {
    color: rgb(220, 105, 95);
    font-size: 10px;
}

/* What this ingredient demands per minute of running - the throughput accent, not the have/need
   green or red: it is a property of the recipe, and never says anything is wrong. */
.production-ingredient-rate {
    color: rgb(85, 221, 245);
    font-size: 10px;
    margin-left: 8px;
    min-width: 46px;
    -unity-text-align: middle-right;
}

.production-consumption-row {
    flex-direction: row;
    margin-bottom: 5px;
}

.production-consumption-pill {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
}

.production-consumption-icon {
    width: 12px;
    height: 12px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.production-consumption-pill-text {
    color: rgb(85, 221, 245);
    font-size: 10px;
}

.inline-icon-row {
    flex-direction: row;
    align-items: center;
}

.inline-icon {
    width: 14px;
    height: 14px;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Under the bar, on the left: the countdown while a cycle runs, and what the machine is doing
   instead when none does. One line, one statement - the panel used to say "waiting for ore" here
   as a time that was not ticking, and again as a status line at the bottom. */
.production-time-label {
    color: rgb(160, 168, 175);
    font-size: 9px;
}

/* Research panel - linear introduction menu (TASK_02_REFONTE_RECHERCHE.md §8) */

.research-panel {
    width: 620px;
}

.research-reserve-label {
    color: rgb(200, 210, 218);
    font-size: 11px;
    margin-left: auto;
    margin-right: 10px;
}

.research-body {
    flex-direction: row;
}

.research-list-scroll {
    flex-grow: 1;
    max-height: 420px;
}

/* Same slim treatment the building grid already uses - the default scroller is far too wide for
   a list this narrow, and its stepper buttons are dead weight. */
.research-list-scroll .unity-scroller--vertical {
    width: 6px;
}

.research-list-scroll .unity-scroller--vertical .unity-scroller__low-button,
.research-list-scroll .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.research-list-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    width: 4px;
    border-radius: 2px;
}

.research-list-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    width: 4px;
    border-radius: 2px;
    background-color: rgb(85, 221, 245);
}

.research-list {
    flex-direction: column;
}

.research-section-label {
    color: rgb(139, 147, 161);
    font-size: 10px;
    letter-spacing: 1px;
    margin: 8px 0 4px;
}

.research-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin-bottom: 4px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
}

/* Selection and hover live at the end of this block, after the per-state rules - see there. */

.research-row-missing-prereq {
    border-color: rgb(239, 108, 108);
}

.research-row-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    border-radius: 10px;
    border-width: 1px;
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
}

.research-row-text {
    flex-grow: 1;
}

.research-row-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
}

.research-row-sub {
    font-size: 9px;
    color: rgb(139, 147, 161);
}

.research-row-status {
    font-size: 10px;
    -unity-text-align: middle-right;
}

.research-state-locked .research-row-icon { background-color: rgb(22, 25, 32); border-color: rgb(61, 67, 79); color: rgb(92, 99, 113); }
.research-state-locked .research-row-name,
.research-state-locked .research-row-status,
.research-state-locked .research-row-sub { color: rgb(107, 114, 128); }

/* Payable: blue, with a soft halo around the row so it reads as "ready to go" at a glance
   (feedback: was pink before, indistinguishable in intent from the other states' warm colors). */
.research-state-payable {
    border-color: rgb(90, 170, 255);
    box-shadow: 0 0 8px 2px rgba(90, 170, 255, 0.35);
}
.research-state-payable .research-row-icon { background-color: rgb(18, 34, 56); border-color: rgb(90, 170, 255); color: rgb(160, 205, 255); }
.research-state-payable .research-row-status { color: rgb(160, 205, 255); }

.research-state-unaffordable .research-row-icon { background-color: rgb(26, 30, 38); border-color: rgb(107, 114, 128); color: rgb(154, 162, 177); }
.research-state-unaffordable .research-row-status { color: rgb(139, 147, 161); }

.research-state-in-progress { border-color: rgb(239, 159, 39); }
.research-state-in-progress .research-row-icon { background-color: rgb(46, 36, 9); border-color: rgb(239, 159, 39); color: rgb(250, 199, 117); }
.research-state-in-progress .research-row-status { color: rgb(250, 199, 117); }

.research-state-completed { opacity: 0.85; }
.research-state-completed .research-row-icon { background-color: rgb(18, 53, 44); border-color: rgb(93, 202, 165); color: rgb(93, 202, 165); }
.research-state-completed .research-row-status { color: rgb(93, 202, 165); }

/* The row the detail panel is describing: a green edge over a green ground, the same "this is the
   one you picked" treatment .recipe-card-selected already uses, in the other colour.

   Written after the per-state rules on purpose. Every .research-state-* above sets a border colour
   at the same specificity, so which of them wins is decided by file order - selection has to come
   last or a payable row would stay blue while selected. A brighter green than the completed teal
   (93, 202, 165), which already means "acquis" a few lines up. */
.research-row-inspected {
    border-width: 2px;
    border-color: rgb(100, 210, 130);
    background-color: rgb(20, 45, 32);
}

/* Under the cursor it is cyan, selected or not: hover is the pointer's own feedback and must not be
   read as the selection it is about to change. Last, and the only rule here carrying a pseudo-class,
   so it wins over both the states and the green above. */
.research-row:hover,
.research-row-inspected:hover {
    border-color: rgb(85, 221, 245);
}

.research-queue-section { margin-top: 6px; }

.research-queue-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin-bottom: 3px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
}

.research-queue-position {
    width: 16px;
    color: rgb(139, 147, 161);
    font-size: 10px;
}

.research-queue-name {
    flex-grow: 1;
    font-size: 10px;
}

.research-queue-button {
    width: 20px;
    height: 20px;
    margin-left: 3px;
    font-size: 9px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(200, 210, 218);
}

/* Detail panel */

.research-detail-panel {
    width: 210px;
    flex-shrink: 0;
    margin-left: 12px;
    padding-left: 12px;
    border-left-width: 1px;
    border-left-color: rgb(48, 59, 66);
}

.research-detail-state {
    color: rgb(250, 199, 117);
    font-size: 10px;
    letter-spacing: 1px;
    margin-bottom: 3px;
}

.research-detail-name {
    color: rgb(232, 235, 240);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.research-detail-description {
    color: rgb(154, 162, 177);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 10px;
}

.research-detail-effect-box {
    background-color: rgb(26, 30, 38);
    border-radius: 4px;
    padding: 7px 8px;
    margin-bottom: 10px;
}

.research-detail-effect-value {
    color: rgb(159, 225, 203);
    font-size: 10px;
    white-space: normal;
}

.research-detail-progress-track {
    /* Overrides extractor-progress-track's 220px - wider than this panel itself (210px),
       which pushed the bar past the panel's edge (feedback: "sort du menu"). */
    width: 190px;
    margin-bottom: 4px;
}

.research-detail-cost-row,
.research-detail-absorption-row {
    flex-direction: row;
    justify-content: space-between;
    font-size: 10px;
    color: rgb(154, 162, 177);
    margin-bottom: 8px;
}

.research-detail-prerequisites {
    margin-bottom: 12px;
}

.research-detail-prereq-met {
    color: rgb(93, 202, 165);
    font-size: 11px;
}

.research-detail-prereq-missing {
    color: rgb(107, 114, 128);
    font-size: 11px;
}

.research-detail-prereq-none {
    color: rgb(107, 114, 128);
    font-size: 11px;
}

.research-detail-action-button {
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(154, 162, 177);
    background-color: rgb(26, 30, 38);
    border-width: 1px;
    border-color: rgb(47, 53, 64);
    border-radius: 6px;
    padding: 8px;
}

.research-legend-row {
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 8px;
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: rgb(48, 59, 66);
}

.research-legend-item {
    font-size: 10px;
    margin-right: 14px;
    color: rgb(139, 147, 161);
}

.research-legend-completed { color: rgb(93, 202, 165); }
.research-legend-in-progress { color: rgb(239, 159, 39); }
.research-legend-payable { color: rgb(237, 147, 177); }
.research-legend-unaffordable { color: rgb(154, 162, 177); }
.research-legend-locked { color: rgb(107, 114, 128); }

/* Top Bar */

.top-bar-header-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 36px;
    background-color: rgba(16, 20, 25, 0.98);
    border-bottom-width: 2px;
    border-bottom-color: rgba(54, 199, 232, 0.5);
}

.top-bar-cards-area {
    position: absolute;
    left: 0;
    top: 0;
    right: 128px;
    bottom: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.top-bar-card {
    background-color: rgb(21, 25, 30);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    margin: 0 3px;
    overflow: hidden;
    height: 28px;
    transition-property: height;
    transition-timing-function: ease-out;
    transition-duration: 0.15s;
}

.top-bar-card-collapsing {
    transition-timing-function: ease-in;
    transition-duration: 0.12s;
}

.top-bar-card:hover {
    border-color: rgba(85, 221, 245, 0.55);
}

.top-bar-card-header {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding: 0 7px;
}

.top-bar-card-icon {
    width: 13px;
    height: 13px;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.top-bar-card-value {
    color: rgb(239, 242, 244);
    font-size: 10px;
    -unity-font-style: bold;
}

.top-bar-card-value-deficit {
    color: rgb(242, 83, 83);
}

/* Nearly saturated, not yet short: the same amber the Building menu uses for "you cannot afford
   this yet" - a warning, deliberately not the red kept for something actually going wrong. */
.top-bar-card-value-strained {
    color: rgb(255, 216, 102);
}

/* Research finished: the one Top Bar state that is good news, so it gets its own colour rather
   than the neutral text every other idle state uses. */
.top-bar-card-value-done {
    color: rgb(96, 226, 130);
}

/* The Core's current directive, named item by item in the collapsed card: the player has to be
   able to read WHAT is being asked for without hovering, which one icon and one figure cannot do. */
.top-bar-directive-number {
    color: rgb(85, 221, 245);
    font-size: 10px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.top-bar-directive-requirements {
    flex-direction: row;
    align-items: center;
}

.top-bar-directive-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 9px;
}

.top-bar-directive-icon {
    width: 15px;
    height: 15px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.top-bar-directive-amount {
    color: rgb(239, 242, 244);
    font-size: 10px;
    -unity-font-style: bold;
}

/* Same "this one is covered" green as the Core panel's own requirement rows. */
.top-bar-directive-amount-met {
    color: rgb(100, 210, 130);
}

.top-bar-card-done {
    border-color: rgb(96, 226, 130);
    background-color: rgb(20, 40, 27);
}

.top-bar-card-detail {
    padding: 0 7px 0 7px;
    height: 0;
    overflow: hidden;
    transition-property: height;
    transition-timing-function: ease-out;
    transition-duration: 0.15s;
}

.top-bar-card-detail-line {
    color: rgb(215, 224, 229);
    font-size: 9px;
    margin-bottom: 2px;
}

.top-bar-card-detail-line-deficit {
    color: rgb(242, 83, 83);
}

.top-bar-card-detail-line-strained {
    color: rgb(255, 216, 102);
}

.top-bar-card-bar-track {
    width: 100%;
    height: 4px;
    background-color: rgb(10, 13, 15);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 3px;
}

.top-bar-card-bar-fill-power {
    height: 100%;
    background-color: rgb(100, 210, 130);
}

.top-bar-card-bar-fill-compute {
    height: 100%;
    background-color: rgb(85, 221, 245);
}

.top-bar-card-bar-fill-research {
    height: 100%;
    background-color: rgb(85, 221, 245);
}

.top-bar-card-bar-fill-buildings {
    height: 100%;
    background-color: rgb(85, 221, 245);
}

.top-bar-icon-button {
    position: absolute;
    top: 0;
    width: 36px;
    height: 36px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(85, 221, 245);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.top-bar-icon-button:hover {
    border-color: rgb(85, 221, 245);
}

.top-bar-menu-button {
    right: 60px;
}

.top-bar-pause-button {
    right: 16px;
}

/* Data Center / Core inspectors */

.datacenter-panel {
    width: 300px;
}

.datacenter-priming-section {
    margin-bottom: 8px;
}

.datacenter-priming-label {
    color: rgb(250, 199, 117);
    font-size: 10px;
    margin-top: 3px;
}

.datacenter-axis-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

.datacenter-axis-value {
    color: rgb(159, 225, 203);
    font-size: 10px;
}

.datacenter-slider {
    margin: 2px 0 8px;
}

.datacenter-threshold-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.datacenter-threshold-name {
    width: 55px;
    color: rgb(200, 210, 218);
    font-size: 10px;
}

.datacenter-threshold-row .datacenter-slider {
    flex-grow: 1;
    margin: 0 6px;
}

.datacenter-threshold-value {
    width: 32px;
    color: rgb(200, 210, 218);
    font-size: 10px;
    -unity-text-align: middle-right;
}

.datacenter-slot-list {
    flex-direction: column;
    margin-bottom: 4px;
}

.datacenter-slot-row {
    padding: 3px 4px;
    margin-bottom: 2px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
}

.datacenter-slot-label {
    color: rgb(215, 224, 229);
    font-size: 9px;
    white-space: normal;
}

.datacenter-slot-empty {
    background-color: rgb(15, 18, 22);
    border-color: rgb(38, 46, 52);
}

.datacenter-slot-empty .datacenter-slot-label {
    color: rgb(120, 128, 135);
}

.datacenter-slot-replacing {
    border-color: rgb(232, 168, 61);
}

.datacenter-slot-replacing .datacenter-slot-label {
    color: rgb(232, 168, 61);
}

/* Building menu - hover details (cost preview) */

.building-details {
    flex-direction: row;
    align-items: flex-start;
    min-height: 72px;
}

.building-details-header {
    flex-direction: row;
    align-items: center;
    width: 180px;
    margin-right: 19px;
}

.building-details-icon {
    width: 43px;
    height: 43px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.building-details-name {
    color: rgb(220, 220, 220);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}

.building-details-info {
    flex-grow: 1;
}

.building-details-section-title {
    color: rgb(160, 168, 175);
    font-size: 11px;
    margin-top: 2px;
    margin-bottom: 3px;
}

.building-details-cost-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    width: 264px;
}

.building-details-cost-icon {
    width: 19px;
    height: 19px;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.building-details-cost-name {
    color: rgb(200, 205, 210);
    font-size: 11px;
    flex-grow: 1;
}

.building-details-cost-have {
    color: rgb(160, 168, 175);
    font-size: 11px;
}

.building-details-cost-have-insufficient {
    color: rgb(220, 105, 95);
}

.building-details-consumption-row {
    flex-direction: row;
}

.building-details-consumption-pill {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
}

.building-details-consumption-icon {
    width: 13px;
    height: 13px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.building-details-consumption-text {
    color: rgb(85, 221, 245);
    font-size: 12px;
}

/* Belt throughput on hover - the accent colour the consumption pills use, since it answers the
   same kind of question (what this building does per unit of time), with no pill around it: there
   is one figure, not a row of them. */
.building-details-throughput {
    color: rgb(85, 221, 245);
    font-size: 12px;
    margin-bottom: 4px;
}

.building-details-status {
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 4px;
}

.building-details-status-locked { color: rgb(135, 147, 156); }
.building-details-status-unaffordable { color: rgb(220, 105, 95); }
.building-details-status-available { color: rgb(100, 210, 130); }

.history-graph {
    width: 100%;
    height: 60px;
    background-color: rgb(13, 16, 20);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    margin-top: 8px;
}

.core-item-amount {
    color: rgb(85, 221, 245);
    font-size: 11px;
    -unity-font-style: bold;
}

/* Run chronometer - a reading, not a control: no border, no hover, and picking-mode Ignore in the
   UXML so it never swallows a wheel or a click the way the pause overlay once did. Tabular-ish
   spacing so the digits do not jitter as the seconds roll over. */
.top-bar-clock {
    position: absolute;
    left: 16px;
    top: 0;
    height: 36px;
    -unity-text-align: middle-left;
    color: rgb(215, 224, 229);
    font-size: 13px;
    letter-spacing: 1px;
}

.top-bar-pause-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 46px;
    -unity-text-align: upper-center;
    color: rgb(85, 221, 245);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.top-bar-refusal-message {
    position: absolute;
    left: 0;
    right: 0;
    top: 46px;
    -unity-text-align: upper-center;
    color: rgb(242, 83, 83);
    font-size: 12px;
    -unity-font-style: bold;
}

/* The pause control, sat against the panel title. Built on the close button's dimensions so the
   header keeps one button size, with a lit state for "this building is currently off". */
.header-title-group {
    flex-direction: row;
    align-items: center;
}

.header-toggle-button {
    width: 22px;
    height: 22px;
    margin-left: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(200, 205, 210);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
}

.header-toggle-button:hover {
    border-color: rgb(85, 221, 245);
    color: rgb(85, 221, 245);
}

.header-toggle-button-on {
    border-color: rgb(255, 216, 102);
    color: rgb(255, 216, 102);
    background-color: rgba(90, 74, 26, 0.55);
}

/* Notification banner (left edge) - generic feed, never interactive. */

.notification-banner-root {
    position: absolute;
    left: 0;
    top: 120px;
    bottom: 140px;
    width: 340px;
    align-items: flex-start;
    justify-content: flex-start;
}

.notification-banner-list {
    flex-direction: column;
    margin-left: 16px;
}

.notification-item {
    background-color: rgba(16, 20, 25, 0.98);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    border-left-width: 3px;
    border-left-color: rgb(85, 221, 245);
    padding: 8px 10px;
    margin-bottom: 6px;
    max-width: 300px;
}

.notification-item-warning {
    border-left-color: rgb(232, 168, 61);
}

.notification-item-critical {
    border-left-color: rgb(222, 107, 74);
}

.notification-message {
    color: rgb(220, 220, 220);
    font-size: 11px;
    white-space: normal;
}

.notification-countdown {
    color: rgb(232, 168, 61);
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 3px;
}

/* Construction site panel - a supply, not a production. Reuses the building panels' frame,
   header and body width, and the same track/fill convention every progress bar here uses.

   One row per ingredient: a label line over a bar filled left to right in the order things
   actually arrive - solid for what is here, hatched for what is coming, bare track for what
   nothing has been found for. The two filled states share the accent colour deliberately: they
   are told apart by TEXTURE, not by hue. Hue alone would collide with the accent's existing
   meaning elsewhere in the game, and would carry nothing at all for a colour-blind player.

   Only an ingredient with material still missing - neither arrived nor on its way - is coloured
   as a problem, name and count together. A bar full end to end means do nothing, whichever
   texture fills it, so the panel reads at a glance without counting. */

.site-supply-row {
    flex-direction: column;
    margin-bottom: 6px;
}

.site-supply-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.site-supply-icon {
    width: 14px;
    height: 14px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.site-supply-name {
    color: rgb(200, 205, 210);
    font-size: 10px;
    flex-grow: 1;
}

.site-supply-count {
    color: rgb(200, 205, 210);
    font-size: 10px;
}

.site-supply-alarming {
    color: rgb(220, 105, 95);
}

.site-bar-track {
    height: 7px;
    flex-direction: row;
    background-color: rgb(38, 46, 52);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    border-radius: 2px;
    overflow: hidden;
}

.site-bar-delivered {
    height: 100%;
    flex-shrink: 0;
    background-color: rgb(85, 221, 245);
}

/* Stripes are painted by HatchFillElement (Painter2D) in the same accent, so this rule carries
   only the geometry. overflow keeps a stroke from bleeding into the segment next door. */
.site-bar-reserved {
    height: 100%;
    flex-shrink: 0;
    overflow: hidden;
}

.site-legend-separator {
    height: 1px;
    background-color: rgb(48, 59, 66);
    margin-top: 4px;
    margin-bottom: 5px;
}

.site-legend {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.site-legend-entry {
    flex-direction: row;
    align-items: center;
}

.site-legend-swatch {
    width: 12px;
    height: 7px;
    margin-right: 4px;
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    border-radius: 2px;
    overflow: hidden;
}

.site-legend-missing {
    background-color: rgb(38, 46, 52);
}

.site-legend-label {
    color: rgb(140, 148, 155);
    font-size: 9px;
}

/* The service line: what the ROBOTS are doing, kept apart from what the bars say about stock.
   Two questions the player asks separately, so two places on the panel. */

.site-service-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.site-service-icon {
    width: 13px;
    height: 13px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

/* The drawn clock, same box as the robot icon so the label never shifts between the two states. */
.site-service-glyph {
    width: 13px;
    height: 13px;
    margin-right: 4px;
}

.site-service-active {
    color: rgb(85, 221, 245);
    font-size: 10px;
}

.site-service-waiting {
    color: rgb(140, 148, 155);
    font-size: 10px;
}

/* The state label used to share this row; only the percentage is left, and it belongs on the right. */
.site-percent-row {
    justify-content: flex-end;
}

/* "Something new here": the green frame that pulses on a control the player has just been handed
   (see NewUnlockPulse, which drives the blink - USS has no keyframe animation). Green because it
   is good news, unlike every red state on these bars.

   Deliberately last in the file and deliberately silent about border-width: it must win over the
   Bottom Nav's own selected-state border colour at equal specificity, and it must not resize the
   frame it lights, or the control would jump by a pixel twice a second. */
.newly-unlocked {
    border-color: rgb(100, 210, 130);
    background-color: rgba(40, 90, 55, 0.55);
}

/* ---- Zoomed-out sector map ---- */

.sector-map-panel {
    width: 940px;
    height: 680px;
}

/* The viewport clips the map; the map element inside it is what pans. A dark ground so an
   undiscovered texel (value 0) reads as unexplored rather than as a hole in the panel. */
.sector-map-viewport {
    flex-grow: 1;
    margin: 8px 0;
    background-color: rgb(10, 13, 17);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    overflow: hidden;
}

.sector-map-footer {
    min-height: 40px;
    flex-direction: column;
    justify-content: center;
}

.sector-map-hover-name {
    color: rgb(222, 232, 238);
    font-size: 14px;
    -unity-font-style: bold;
}

/* Deliberately quiet: on an unreconnoitred sector this line says only "non reconnu", and it must
   not look like withheld information. */
.sector-map-hover-detail {
    color: rgb(138, 152, 160);
    font-size: 12px;
}

/* The map button sits in the slot the layout reserved for a minimap. Not an icon: at this size a
   thumbnail of a 10 000-cell world would be a grey square, so the slot says the word instead. */
.bottom-nav-map-button {
    flex-grow: 1;
    background-color: rgb(16, 20, 25);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    border-radius: 3px;
    color: rgb(138, 152, 160);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.bottom-nav-map-button:hover {
    color: rgb(85, 221, 245);
    border-color: rgb(85, 221, 245);
}

/* A building's name is a name, not a section heading. It keeps the title's colour and weight but
   drops the letter-spacing, which only reads well on the spaced capitals of a label. */
.title-name {
    letter-spacing: 0;
}

/* Spaced capitals mark a section heading, and now nothing else does - so the spacing is the mark
   rather than mere decoration. Deliberately not folded into .extractor-section-label: the Compute
   panel reuses that class for value lines ("Reserve: 24 900 CU"), which must not be spaced out. */
.section-label-spaced {
    letter-spacing: 1px;
}

/* ---------------------------------------------------------------------------------------------
   Panneau de production - refonte de la mise en forme

   Everything here is scoped under .production-panel on purpose. The classes it overrides
   (.panel, .header-row, .extractor-section-label, .production-ingredient-*) are shared with the
   Extractor, Storage, Core and Data Center panels, which have not been restyled yet - an
   unscoped change would silently reshape five panels nobody looked at.
   --------------------------------------------------------------------------------------------- */

/* Tabular figures. UI Toolkit exposes no OpenType feature properties, so `tnum` is unreachable and
   a monospaced face is the only way to get columns of digits that do not move. Roboto Mono ships
   with Unity under Apache 2.0; it is copied into Assets because the Editor's own copy lives in
   Editor/Data/Resources and would resolve in the Editor and be missing from a build.

   Applied to values only. Proportional digits make 128 wider than 34, so a counter shifts its own
   left edge every time it changes and the eye has to find it again. */
.mono-value {
    -unity-font-definition: url("Fonts/RobotoMono-Regular.ttf");
}

/* Square corners and a flush right edge: the panel is part of the screen frame, not a card
   floating on top of it. */
/* 320px is the floor, not a taste: the Recettes tab lays three 92px cards with 3px margins either
   side, which needs 294px of content plus the 22px of padding. Narrower and the grid drops to two
   columns. */
.overlay-root-right .production-panel {
    width: 320px;
    margin-right: 0;
    padding: 11px;
    border-radius: 0;
    border-right-width: 0;
}

/* Separators run the full width of the panel, so they read as divisions of it rather than as
   underlines of the text above them. The negative margins undo the panel's own padding, the
   padding puts the content back where it was. */
.production-panel .header-row {
    margin-left: -11px;
    margin-right: -11px;
    padding-left: 11px;
    padding-right: 11px;
    padding-bottom: 8px;
    margin-bottom: 0;
}

.production-panel .production-tab-bar {
    margin-left: -11px;
    margin-right: -11px;
    padding-left: 11px;
    padding-right: 11px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(48, 59, 66);
}

/* An underlined tab, not a boxed one: two bordered boxes side by side read as two buttons, and the
   inactive one competed with the active for the same attention. */
.production-panel .production-tab-button {
    height: 26px;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-font-style: normal;
    font-size: 11px;
    margin-bottom: -1px;
}

.production-panel .production-tab-button-active {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgb(85, 221, 245);
    color: rgb(85, 221, 245);
}

.production-panel .header-toggle-button,
.production-panel .close-button {
    border-radius: 0;
}

.production-panel .extractor-progress-track {
    height: 8px;
    border-radius: 0;
    border-width: 0;
    background-color: rgb(28, 34, 40);
}

/* --- Spacing, all of it, in one place ---------------------------------------------------------
   Every vertical gap in the panel is set here rather than beside the rule it overrides. Scattering
   them cost a whole round: `.production-rate-block .extractor-section-label` sat 1300 lines above
   `.production-panel .extractor-section-label`, tied with it on specificity, and lost on source
   order - a correction that was in the file and changed nothing on screen. Two class names deep,
   grouped and last, is a rule that cannot quietly lose. */

.production-panel .extractor-section-label {
    margin-top: 8px;
    margin-bottom: 2px;
}

.production-panel .production-tab-bar {
    margin-bottom: 8px;
}

.production-panel .production-current-row {
    margin-top: 5px;
    margin-bottom: 4px;
}

.production-panel .production-rate-block {
    margin-top: 4px;
    margin-bottom: 0;
}

.production-panel .production-ingredient-row {
    margin-bottom: 2px;
}

.production-panel .progress-info-row {
    margin-top: 0;
    margin-bottom: 0;
}

.production-panel .production-consumption-row {
    margin-bottom: 0;
}

/* DÉBIT is a caption on its own figure, not another section, so it drops the section rhythm and
   sits tight against the number below it.

   Three selectors deep on purpose. Written as `.production-rate-block .extractor-section-label` it
   tied on specificity with the rule directly above and lost on source order alone - the override
   was in the file, and had no effect at all. */
.production-panel .production-rate-block .extractor-section-label {
    margin-top: 0;
    margin-bottom: -2px;
}

/* Values line up in a column of their own, so a ratio changing from 0 / 1 to 12 / 1 does not
   shift the name beside it. */
.production-panel .production-ingredient-status-ok,
.production-panel .production-ingredient-status-missing,
.production-panel .production-current-amount {
    min-width: 46px;
    -unity-text-align: middle-right;
}

/* Power in amber and Compute in green, the colours they already carry in the top bar. They were
   both cyan here, which made the panel's accent colour mean "a number" rather than anything. */
.production-consumption-power {
    color: rgb(239, 159, 39);
}

.production-consumption-compute {
    color: rgb(100, 210, 130);
}

/* Which side of the building a held item is sitting on - a qualifier on the name, not a value, so
   it is set apart from both instead of being glued to the count as "1  (SORTIE)". */
.production-ingredient-side {
    color: rgb(120, 130, 138);
    font-size: 9px;
    margin-right: 6px;
}

/* The map button's own pulse, on the lit half of NewUnlockPulse's cycle. Green rather than the
   Research menu's cyan: cyan is this UI's ordinary accent and says "interactive", while the map
   appearing is a one-off event - somewhere beyond the Core has become reachable. Only the colours
   change, never the border width, so the button does not twitch a pixel every half second. */
.bottom-nav-map-button.newly-reachable {
    color: rgb(100, 210, 130);
    border-color: rgb(100, 210, 130);
    background-color: rgb(20, 38, 27);
}

/* The right-click menu on a storage slot. Absolutely positioned inside the panel so it survives the
   grid being rebuilt every frame, and drawn over it. */
.storage-slot-menu {
    position: absolute;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(85, 221, 245);
    padding: 2px;
}

.storage-slot-menu-item {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(220, 105, 95);
    font-size: 11px;
    padding: 4px 10px;
    -unity-text-align: middle-left;
}

.storage-slot-menu-item:hover {
    background-color: rgb(46, 26, 26);
}

/* --- The map's launch pane -------------------------------------------------------------------
   The map and the decision about it sit side by side: choosing a target and choosing what to send
   there is one gesture, and answering must not move the map out from under the pointer. */

.sector-map-body {
    flex-direction: row;
    flex-grow: 1;
    margin: 8px 0;
}

.sector-map-body .sector-map-viewport {
    margin: 0 8px 0 0;
}

.sector-map-aside {
    width: 240px;
    flex-direction: column;
}

.sector-map-target-name {
    color: rgb(222, 232, 238);
    font-size: 14px;
    -unity-font-style: bold;
}

/* Quiet, like the hover line and for the same reason: on an unreconnoitred sector this says only
   that nobody has been, and must not read as information being withheld. */
.sector-map-target-detail {
    color: rgb(138, 152, 160);
    font-size: 11px;
    margin-bottom: 4px;
    white-space: normal;
}

.sector-map-mission-list {
    flex-direction: column;
}

.sector-map-mission-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.sector-map-mission-name {
    color: rgb(200, 205, 210);
    font-size: 11px;
    flex-grow: 1;
}

.sector-map-mission-duration {
    color: rgb(135, 147, 156);
    font-size: 10px;
    margin-right: 8px;
}

.sector-map-mission-launch {
    height: 22px;
    padding: 0 10px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(85, 221, 245);
    color: rgb(85, 221, 245);
    font-size: 10px;
}

.sector-map-mission-launch:hover {
    background-color: rgb(26, 40, 46);
}

/* A refusal is stated, not shouted: it is usually a fact about where the player is pointing, not a
   mistake they made. */
.sector-map-mission-refusal {
    color: rgb(120, 130, 138);
    font-size: 10px;
    -unity-text-align: middle-right;
    min-width: 96px;
}

.sector-map-mission-none {
    color: rgb(120, 130, 138);
    font-size: 11px;
    white-space: normal;
}

.sector-map-fleet {
    color: rgb(135, 147, 156);
    font-size: 10px;
    margin-top: 8px;
}

/* One in-flight mission's remaining time, on the Top Bar's permanent counter. Same shape as the
   directive's requirement chips - they are the same kind of statement, a thing being waited on. */
.top-bar-mission-chip {
    color: rgb(85, 221, 245);
    font-size: 11px;
    margin-right: 8px;
}
