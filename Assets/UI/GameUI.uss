.hidden {
    display: none;
}

.overlay-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-start;
}

/* Per-building context panels (Extractor, Storage box, Production) dock to the right edge
   instead of the centered default used by the Building catalog/aggregate Storage view. */
.overlay-root-right {
    align-items: flex-end;
}

.overlay-root-right .panel {
    align-self: flex-end;
    margin-right: 24px;
}

.panel {
    margin-top: 90px;
    align-self: center;
    background-color: rgba(16, 20, 25, 0.98);
    border-width: 2px;
    border-color: rgb(48, 59, 66);
    padding: 10px;
}

.panel-accent {
    border-left-width: 1px;
    border-left-color: rgba(54, 199, 232, 0.4);
}

.header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(48, 59, 66);
    padding-bottom: 5px;
}

.title {
    color: rgb(85, 221, 245);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.close-button {
    width: 22px;
    height: 22px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(220, 220, 220);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.close-button:hover {
    border-color: rgb(85, 221, 245);
    color: rgb(85, 221, 245);
}

.building-body {
    flex-direction: column;
}

.building-top-row {
    flex-direction: row;
}

.h-separator {
    height: 1px;
    background-color: rgb(48, 59, 66);
    margin: 10px 0;
}

.category-column {
    width: 150px;
    margin-right: 10px;
}

.v-separator {
    width: 1px;
    background-color: rgb(48, 59, 66);
    margin: 0 10px 0 0;
}

.category-button {
    height: 40px;
    margin-bottom: 6px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(200, 205, 210);
    font-size: 13px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 0 8px;
}

.category-button:hover {
    border-color: rgb(85, 221, 245);
}

.category-button-selected {
    border-color: rgb(85, 221, 245);
    color: rgb(85, 221, 245);
    background-color: rgb(26, 34, 40);
}

.category-button-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.category-button-label {
    color: rgb(200, 205, 210);
    font-size: 12px;
    -unity-text-align: middle-left;
}

.category-button-selected .category-button-label {
    color: rgb(85, 221, 245);
}

.building-grid-scroll {
    width: 360px;
    max-height: 200px;
}

.building-grid-scroll .unity-scroller--vertical {
    width: 6px;
}

.building-grid-scroll .unity-scroller--vertical .unity-scroller__low-button,
.building-grid-scroll .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.building-grid-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    width: 4px;
    border-radius: 2px;
}

.building-grid-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    width: 4px;
    border-radius: 2px;
    background-color: rgb(85, 221, 245);
}

.building-grid {
    flex-direction: column;
}

.building-grid-row {
    flex-direction: row;
}

.building-card {
    width: 112px;
    height: 90px;
    margin: 4px;
    background-color: rgb(24, 29, 35);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    white-space: normal;
}

.building-card:hover {
    border-color: rgb(85, 221, 245);
    background-color: rgb(30, 37, 44);
}

.building-card-locked {
    opacity: 0.5;
}

.building-card-unaffordable {
    border-color: rgb(255, 216, 102);
}

.building-card-unaffordable .building-card-icon {
    -unity-background-image-tint-color: rgb(255, 216, 102);
}

.building-card-unaffordable .building-card-label {
    color: rgb(255, 216, 102);
}

.building-card-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.building-card-label {
    color: rgb(220, 220, 220);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.storage-grid {
    flex-direction: column;
}

.storage-grid-row {
    flex-direction: row;
}

.storage-card {
    width: 52px;
    height: 52px;
    margin: 4px;
    background-color: rgb(10, 13, 15);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    border-radius: 3px;
    position: relative;
}

.storage-card-icon {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.storage-card-count {
    position: absolute;
    right: 2px;
    bottom: 1px;
    background-color: rgba(0, 0, 0, 0.65);
    color: rgb(85, 221, 245);
    font-size: 11px;
    -unity-font-style: bold;
    padding: 0 3px;
    border-radius: 3px;
}

.storage-card-empty {
    background-color: rgb(10, 13, 15);
    border-color: rgb(38, 46, 52);
}

.storage-empty-label {
    color: rgb(140, 148, 155);
    font-size: 12px;
    padding: 6px 4px;
}

/* Extractor panel */

.extractor-body {
    width: 220px;
}

.extractor-section-label {
    color: rgb(160, 168, 175);
    font-size: 10px;
    margin-bottom: 3px;
    margin-top: 5px;
}

.extractor-progress-track {
    width: 220px;
    height: 14px;
    background-color: rgb(10, 13, 15);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    border-radius: 3px;
    overflow: hidden;
}

.extractor-progress-fill {
    height: 100%;
    background-color: rgb(85, 221, 245);
}

/* Bottom Nav */

.bottom-nav {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 44px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(16, 20, 25, 0.92);
    border-top-width: 2px;
    border-top-color: rgba(54, 199, 232, 0.5);
    padding-left: 8px;
}

.bottom-nav-minimap {
    width: 44px;
    height: 38px;
    background-color: rgb(10, 13, 15);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    margin-right: 12px;
}

.bottom-nav-category-row {
    flex-direction: row;
    margin-right: 12px;
}

.bottom-nav-category-button {
    width: 40px;
    height: 40px;
    margin: 0 8px 0 0;
    padding: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.bottom-nav-category-button-active {
    background-color: rgb(22, 50, 58);
    border-color: rgb(85, 221, 245);
}

.bottom-nav-category-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.bottom-nav-toolbar-row {
    flex-direction: row;
}

.bottom-nav-slot {
    width: 36px;
    height: 36px;
    margin-right: 5px;
    border-radius: 3px;
}

.bottom-nav-slot-empty {
    background-color: rgb(10, 13, 15);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
}

.bottom-nav-slot-icon {
    position: absolute;
    left: 2px;
    top: 2px;
    right: 2px;
    bottom: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.bottom-nav-slot-number {
    position: absolute;
    left: 2px;
    top: 0;
    color: rgb(135, 147, 156);
    font-size: 8px;
}

.bottom-nav-slot-badge {
    position: absolute;
    right: 2px;
    bottom: 0;
    color: rgb(85, 221, 245);
    font-size: 9px;
    -unity-font-style: bold;
}

/* Production panel (Foundry/Factory/AdvancedFoundry/Assembler) */

/* Wide enough for a full row of 3 recipe cards (3 x 92px + their 3px margins + panel padding). */
.production-panel {
    width: 320px;
}

.production-tab-bar {
    flex-direction: row;
    margin-bottom: 6px;
}

.production-tab-button {
    flex-grow: 1;
    height: 24px;
    margin: 0;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(160, 168, 175);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.production-tab-button-active {
    border-color: rgb(85, 221, 245);
    color: rgb(85, 221, 245);
    background-color: rgb(26, 34, 40);
}

.recipes-grid {
    flex-direction: column;
}

.recipes-grid-row {
    flex-direction: row;
}

.recipe-card {
    width: 92px;
    margin: 3px;
    padding: 4px;
    background-color: rgb(24, 29, 35);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    align-items: center;
}

.recipe-card:hover {
    border-color: rgba(85, 221, 245, 0.55);
}

.recipe-card-selected {
    border-width: 2px;
    border-color: rgb(85, 221, 245);
    background-color: rgb(22, 50, 58);
}

.recipe-card-unavailable {
    opacity: 0.6;
}

.recipe-card-icon-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.recipe-card-icon {
    width: 18px;
    height: 18px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-card-amount {
    color: rgb(85, 221, 245);
    font-size: 9px;
}

.recipe-card-divider {
    width: 100%;
    height: 1px;
    background-color: rgb(48, 59, 66);
    margin-bottom: 3px;
}

.recipe-card-name {
    color: rgb(215, 224, 229);
    font-size: 9px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
    width: 100%;
    margin-bottom: 3px;
}

.recipe-card-ingredients-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-bottom: 3px;
}

.recipe-card-ingredient-icon {
    width: 12px;
    height: 12px;
    margin: 0 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-card-ingredient-qty {
    color: rgb(160, 168, 175);
    font-size: 7px;
    margin-right: 3px;
}

.recipe-card-time {
    color: rgb(135, 147, 156);
    font-size: 8px;
}

.recipe-action-button {
    height: 26px;
    margin: 4px 3px 0 3px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(200, 205, 210);
    font-size: 10px;
    -unity-font-style: bold;
}

.recipe-action-button:disabled {
    color: rgb(90, 96, 102);
}

.production-empty-state {
    color: rgb(140, 148, 155);
    font-size: 10px;
    padding: 5px 3px;
}

.production-content {
    width: 200px;
}

.production-current-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.production-current-icon {
    width: 32px;
    height: 32px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.production-current-amount {
    color: rgb(85, 221, 245);
    font-size: 10px;
}

.production-current-name {
    color: rgb(220, 220, 220);
    font-size: 11px;
    -unity-font-style: bold;
}

.production-progress-track {
    width: 100%;
}

.production-percent-label {
    color: rgb(160, 168, 175);
    font-size: 9px;
    -unity-text-align: upper-right;
}

/* Remaining time on the left, percentage on the right, directly under a progress bar
   (Production and Extractor panels share it). */
.progress-info-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 5px;
}

.production-ingredients-list {
    flex-direction: column;
}

.production-ingredient-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.production-ingredient-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.production-ingredient-name {
    color: rgb(200, 205, 210);
    font-size: 10px;
    flex-grow: 1;
}

.production-ingredient-status-ok {
    color: rgb(100, 210, 130);
    font-size: 10px;
}

.production-ingredient-status-missing {
    color: rgb(220, 105, 95);
    font-size: 10px;
}

.production-consumption-row {
    flex-direction: row;
    margin-bottom: 5px;
}

.production-consumption-pill {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
}

.production-consumption-icon {
    width: 12px;
    height: 12px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.production-consumption-pill-text {
    color: rgb(85, 221, 245);
    font-size: 10px;
}

.inline-icon-row {
    flex-direction: row;
    align-items: center;
}

.inline-icon {
    width: 14px;
    height: 14px;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.production-state-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.production-state-label {
    font-size: 10px;
    -unity-font-style: bold;
}

.production-time-label {
    color: rgb(160, 168, 175);
    font-size: 9px;
}

/* Research panel - linear introduction menu (TASK_02_REFONTE_RECHERCHE.md §8) */

.research-panel {
    width: 620px;
}

.research-reserve-label {
    color: rgb(200, 210, 218);
    font-size: 11px;
    margin-left: auto;
    margin-right: 10px;
}

.research-body {
    flex-direction: row;
}

.research-list-scroll {
    flex-grow: 1;
    max-height: 420px;
}

.research-list {
    flex-direction: column;
}

.research-section-label {
    color: rgb(139, 147, 161);
    font-size: 10px;
    letter-spacing: 1px;
    margin: 8px 0 4px;
}

.research-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin-bottom: 4px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
}

.research-row:hover {
    border-color: rgba(85, 221, 245, 0.55);
}

.research-row-inspected {
    border-width: 2px;
}

.research-row-missing-prereq {
    border-color: rgb(239, 108, 108);
}

.research-row-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    border-radius: 10px;
    border-width: 1px;
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
}

.research-row-text {
    flex-grow: 1;
}

.research-row-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
}

.research-row-sub {
    font-size: 9px;
    color: rgb(139, 147, 161);
}

.research-row-status {
    font-size: 10px;
    -unity-text-align: middle-right;
}

.research-state-locked .research-row-icon { background-color: rgb(22, 25, 32); border-color: rgb(61, 67, 79); color: rgb(92, 99, 113); }
.research-state-locked .research-row-name,
.research-state-locked .research-row-status,
.research-state-locked .research-row-sub { color: rgb(107, 114, 128); }

/* Payable: blue, with a soft halo around the row so it reads as "ready to go" at a glance
   (feedback: was pink before, indistinguishable in intent from the other states' warm colors). */
.research-state-payable {
    border-color: rgb(90, 170, 255);
    box-shadow: 0 0 8px 2px rgba(90, 170, 255, 0.35);
}
.research-state-payable .research-row-icon { background-color: rgb(18, 34, 56); border-color: rgb(90, 170, 255); color: rgb(160, 205, 255); }
.research-state-payable .research-row-status { color: rgb(160, 205, 255); }

.research-state-unaffordable .research-row-icon { background-color: rgb(26, 30, 38); border-color: rgb(107, 114, 128); color: rgb(154, 162, 177); }
.research-state-unaffordable .research-row-status { color: rgb(139, 147, 161); }

.research-state-in-progress { border-color: rgb(239, 159, 39); }
.research-state-in-progress .research-row-icon { background-color: rgb(46, 36, 9); border-color: rgb(239, 159, 39); color: rgb(250, 199, 117); }
.research-state-in-progress .research-row-status { color: rgb(250, 199, 117); }

.research-state-completed { opacity: 0.85; }
.research-state-completed .research-row-icon { background-color: rgb(18, 53, 44); border-color: rgb(93, 202, 165); color: rgb(93, 202, 165); }
.research-state-completed .research-row-status { color: rgb(93, 202, 165); }

.research-queue-section { margin-top: 6px; }

.research-queue-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin-bottom: 3px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
}

.research-queue-position {
    width: 16px;
    color: rgb(139, 147, 161);
    font-size: 10px;
}

.research-queue-name {
    flex-grow: 1;
    font-size: 10px;
}

.research-queue-button {
    width: 20px;
    height: 20px;
    margin-left: 3px;
    font-size: 9px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(200, 210, 218);
}

/* Detail panel */

.research-detail-panel {
    width: 210px;
    flex-shrink: 0;
    margin-left: 12px;
    padding-left: 12px;
    border-left-width: 1px;
    border-left-color: rgb(48, 59, 66);
}

.research-detail-state {
    color: rgb(250, 199, 117);
    font-size: 10px;
    letter-spacing: 1px;
    margin-bottom: 3px;
}

.research-detail-name {
    color: rgb(232, 235, 240);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.research-detail-description {
    color: rgb(154, 162, 177);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 10px;
}

.research-detail-effect-box {
    background-color: rgb(26, 30, 38);
    border-radius: 4px;
    padding: 7px 8px;
    margin-bottom: 10px;
}

.research-detail-effect-value {
    color: rgb(159, 225, 203);
    font-size: 10px;
    white-space: normal;
}

.research-detail-progress-track {
    /* Overrides extractor-progress-track's 220px - wider than this panel itself (210px),
       which pushed the bar past the panel's edge (feedback: "sort du menu"). */
    width: 190px;
    margin-bottom: 4px;
}

.research-detail-cost-row,
.research-detail-absorption-row {
    flex-direction: row;
    justify-content: space-between;
    font-size: 10px;
    color: rgb(154, 162, 177);
    margin-bottom: 8px;
}

.research-detail-prerequisites {
    margin-bottom: 12px;
}

.research-detail-prereq-met {
    color: rgb(93, 202, 165);
    font-size: 11px;
}

.research-detail-prereq-missing {
    color: rgb(107, 114, 128);
    font-size: 11px;
}

.research-detail-prereq-none {
    color: rgb(107, 114, 128);
    font-size: 11px;
}

.research-detail-action-button {
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(154, 162, 177);
    background-color: rgb(26, 30, 38);
    border-width: 1px;
    border-color: rgb(47, 53, 64);
    border-radius: 6px;
    padding: 8px;
}

.research-legend-row {
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 8px;
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: rgb(48, 59, 66);
}

.research-legend-item {
    font-size: 10px;
    margin-right: 14px;
    color: rgb(139, 147, 161);
}

.research-legend-completed { color: rgb(93, 202, 165); }
.research-legend-in-progress { color: rgb(239, 159, 39); }
.research-legend-payable { color: rgb(237, 147, 177); }
.research-legend-unaffordable { color: rgb(154, 162, 177); }
.research-legend-locked { color: rgb(107, 114, 128); }

/* Top Bar */

.top-bar-header-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 36px;
    background-color: rgba(16, 20, 25, 0.98);
    border-bottom-width: 2px;
    border-bottom-color: rgba(54, 199, 232, 0.5);
}

.top-bar-cards-area {
    position: absolute;
    left: 0;
    top: 0;
    right: 128px;
    bottom: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.top-bar-card {
    background-color: rgb(21, 25, 30);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    margin: 0 3px;
    overflow: hidden;
    height: 28px;
    transition-property: height;
    transition-timing-function: ease-out;
    transition-duration: 0.15s;
}

.top-bar-card-collapsing {
    transition-timing-function: ease-in;
    transition-duration: 0.12s;
}

.top-bar-card:hover {
    border-color: rgba(85, 221, 245, 0.55);
}

.top-bar-card-header {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding: 0 7px;
}

.top-bar-card-icon {
    width: 13px;
    height: 13px;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.top-bar-card-value {
    color: rgb(239, 242, 244);
    font-size: 10px;
    -unity-font-style: bold;
}

.top-bar-card-value-deficit {
    color: rgb(242, 83, 83);
}

.top-bar-card-detail {
    padding: 0 7px 0 7px;
    height: 0;
    overflow: hidden;
    transition-property: height;
    transition-timing-function: ease-out;
    transition-duration: 0.15s;
}

.top-bar-card-detail-line {
    color: rgb(215, 224, 229);
    font-size: 9px;
    margin-bottom: 2px;
}

.top-bar-card-detail-line-deficit {
    color: rgb(242, 83, 83);
}

.top-bar-card-bar-track {
    width: 100%;
    height: 4px;
    background-color: rgb(10, 13, 15);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 3px;
}

.top-bar-card-bar-fill-power {
    height: 100%;
    background-color: rgb(100, 210, 130);
}

.top-bar-card-bar-fill-compute {
    height: 100%;
    background-color: rgb(85, 221, 245);
}

.top-bar-card-bar-fill-research {
    height: 100%;
    background-color: rgb(85, 221, 245);
}

.top-bar-card-bar-fill-buildings {
    height: 100%;
    background-color: rgb(85, 221, 245);
}

.top-bar-icon-button {
    position: absolute;
    top: 0;
    width: 36px;
    height: 36px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    color: rgb(85, 221, 245);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.top-bar-icon-button:hover {
    border-color: rgb(85, 221, 245);
}

.top-bar-menu-button {
    right: 60px;
}

.top-bar-pause-button {
    right: 16px;
}

/* Data Center / Core inspectors */

.datacenter-panel {
    width: 300px;
}

.datacenter-priming-section {
    margin-bottom: 8px;
}

.datacenter-priming-label {
    color: rgb(250, 199, 117);
    font-size: 10px;
    margin-top: 3px;
}

.datacenter-axis-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

.datacenter-axis-value {
    color: rgb(159, 225, 203);
    font-size: 10px;
}

.datacenter-slider {
    margin: 2px 0 8px;
}

.datacenter-threshold-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.datacenter-threshold-name {
    width: 55px;
    color: rgb(200, 210, 218);
    font-size: 10px;
}

.datacenter-threshold-row .datacenter-slider {
    flex-grow: 1;
    margin: 0 6px;
}

.datacenter-threshold-value {
    width: 32px;
    color: rgb(200, 210, 218);
    font-size: 10px;
    -unity-text-align: middle-right;
}

.datacenter-slot-list {
    flex-direction: column;
    margin-bottom: 4px;
}

.datacenter-slot-row {
    padding: 3px 4px;
    margin-bottom: 2px;
    background-color: rgb(20, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
}

.datacenter-slot-label {
    color: rgb(215, 224, 229);
    font-size: 9px;
    white-space: normal;
}

.datacenter-slot-empty {
    background-color: rgb(15, 18, 22);
    border-color: rgb(38, 46, 52);
}

.datacenter-slot-empty .datacenter-slot-label {
    color: rgb(120, 128, 135);
}

.datacenter-slot-replacing {
    border-color: rgb(232, 168, 61);
}

.datacenter-slot-replacing .datacenter-slot-label {
    color: rgb(232, 168, 61);
}

/* Building menu - hover details (cost preview) */

.building-details {
    flex-direction: row;
    align-items: flex-start;
    min-height: 60px;
}

.building-details-header {
    flex-direction: row;
    align-items: center;
    width: 150px;
    margin-right: 16px;
}

.building-details-icon {
    width: 36px;
    height: 36px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.building-details-name {
    color: rgb(220, 220, 220);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}

.building-details-info {
    flex-grow: 1;
}

.building-details-section-title {
    color: rgb(160, 168, 175);
    font-size: 9px;
    margin-top: 2px;
    margin-bottom: 3px;
}

.building-details-cost-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    width: 220px;
}

.building-details-cost-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.building-details-cost-name {
    color: rgb(200, 205, 210);
    font-size: 9px;
    flex-grow: 1;
}

.building-details-cost-have {
    color: rgb(160, 168, 175);
    font-size: 9px;
}

.building-details-cost-have-insufficient {
    color: rgb(220, 105, 95);
}

.building-details-consumption-row {
    flex-direction: row;
}

.building-details-consumption-pill {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
}

.building-details-consumption-icon {
    width: 13px;
    height: 13px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.building-details-consumption-text {
    color: rgb(85, 221, 245);
    font-size: 10px;
}

.building-details-status {
    font-size: 9px;
    -unity-font-style: bold;
    margin-top: 4px;
}

.building-details-status-locked { color: rgb(135, 147, 156); }
.building-details-status-unaffordable { color: rgb(220, 105, 95); }
.building-details-status-available { color: rgb(100, 210, 130); }

.history-graph {
    width: 100%;
    height: 60px;
    background-color: rgb(13, 16, 20);
    border-width: 1px;
    border-color: rgb(48, 59, 66);
    margin-top: 8px;
}

.core-item-amount {
    color: rgb(85, 221, 245);
    font-size: 11px;
    -unity-font-style: bold;
}

.top-bar-pause-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 46px;
    -unity-text-align: upper-center;
    color: rgb(85, 221, 245);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.top-bar-refusal-message {
    position: absolute;
    left: 0;
    right: 0;
    top: 46px;
    -unity-text-align: upper-center;
    color: rgb(242, 83, 83);
    font-size: 12px;
    -unity-font-style: bold;
}

.state-producing {
    color: rgb(85, 221, 245);
}

.state-waiting {
    color: rgb(232, 168, 61);
}

.state-blocked {
    color: rgb(222, 107, 74);
}

.state-idle {
    color: rgb(135, 147, 156);
}
