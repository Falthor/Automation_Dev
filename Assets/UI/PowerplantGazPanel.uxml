<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameUI.uss" />

    <ui:VisualElement name="PowerplantGazPanelRoot" class="overlay-root overlay-root-right hidden" picking-mode="Ignore">
        <ui:VisualElement class="panel panel-accent" picking-mode="Position">
            <ui:VisualElement class="header-row">
                <ui:Label text="Powerplant Gaz" class="title title-name" />
                <ui:Button name="PowerplantGazCloseButton" text="&#215;" class="close-button" />
            </ui:VisualElement>
            <ui:VisualElement class="extractor-body">
                <ui:Label text="CARBURANT" class="extractor-section-label section-label-spaced" />
                <ui:VisualElement class="storage-card">
                    <ui:VisualElement name="PowerplantGazFuelIcon" class="storage-card-icon" />
                    <ui:Label name="PowerplantGazFuelAmount" text="0" class="storage-card-count" />
                </ui:VisualElement>
                <ui:Label text="CYCLE" class="extractor-section-label section-label-spaced" />
                <ui:VisualElement class="extractor-progress-track">
                    <ui:VisualElement name="PowerplantGazProgressFill" class="extractor-progress-fill" />
                </ui:VisualElement>
                <ui:Label name="PowerplantGazProgressLabel" text="0.0 / 0.0 s" class="production-time-label" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
