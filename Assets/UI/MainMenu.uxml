<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="MainMenu.uss" />

    <ui:VisualElement name="MainMenuRoot" class="main-menu-root">
        <ui:VisualElement name="MainMenuBackground" class="main-menu-background" picking-mode="Ignore" />

        <ui:VisualElement name="MainMenuPanel" class="main-menu-panel">
            <ui:Label text="FALTHOR" class="main-menu-title" />
            <ui:Button name="NewGameButton" text="NOUVELLE PARTIE" class="main-menu-button" />
            <ui:Button name="LoadButton" text="CHARGER" class="main-menu-button" />
            <ui:Button name="ShortcutsButton" text="RACCOURCIS" class="main-menu-button" />
        </ui:VisualElement>

        <ui:VisualElement name="ShortcutsOverlay" class="confirm-overlay hidden">
            <ui:VisualElement class="shortcuts-dialog">
                <ui:Label text="RACCOURCIS" class="shortcuts-title" />
                <ui:Label name="ShortcutsHint" text="Cliquez une touche pour la réassigner, puis appuyez sur la nouvelle. Échap annule la saisie." class="shortcuts-hint" />

                <ui:ScrollView name="ShortcutsList" class="shortcuts-list" />

                <ui:VisualElement class="shortcuts-footer">
                    <ui:Button name="ShortcutsResetAllButton" text="TOUT RÉINITIALISER" class="main-menu-button shortcuts-footer-button" />
                    <ui:Button name="ShortcutsCloseButton" text="FERMER" class="main-menu-button shortcuts-footer-button" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="ShortcutsConflictOverlay" class="confirm-overlay hidden">
                <ui:VisualElement class="confirm-dialog">
                    <ui:Label name="ShortcutsConflictMessage" class="confirm-message" />
                    <ui:VisualElement class="confirm-button-row">
                        <ui:Button name="ShortcutsConflictCancelButton" text="ANNULER" class="main-menu-button confirm-button" />
                        <ui:Button name="ShortcutsConflictAcceptButton" text="ECRASER" class="main-menu-button confirm-button confirm-button-danger" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="ConfirmOverlay" class="confirm-overlay hidden">
            <ui:VisualElement class="confirm-dialog">
                <ui:Label text="Une sauvegarde existe déjà. Commencer une nouvelle partie l'écrasera définitivement." class="confirm-message" />
                <ui:VisualElement class="confirm-button-row">
                    <ui:Button name="ConfirmCancelButton" text="ANNULER" class="main-menu-button confirm-button" />
                    <ui:Button name="ConfirmAcceptButton" text="ECRASER" class="main-menu-button confirm-button confirm-button-danger" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
